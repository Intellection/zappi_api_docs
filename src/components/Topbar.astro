---

---

<header class="topbar" data-pagefind-ignore>
  <button type="button" class="topbar-icon menu-button" data-nav-toggle aria-label="Open navigation" aria-controls="sidebar">
    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
      ><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg
    >
  </button>
  <a class="brand" href="/">
    <img src="/zappi-logo-tile.png" alt="" width="28" height="28" />
    <span class="brand-name">Zappi</span>
    <span class="brand-product">API</span>
  </a>
  <button type="button" class="search-trigger" data-search-open>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
      ><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path
        d="M10.5 10.5L14 14"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    >
    <span>Search</span>
    <kbd>⌘K</kbd>
  </button>
  <nav class="topbar-links" aria-label="Site">
    <a href="#changelog">Changelog</a>
    <a href="mailto:support@zappistore.com">Support</a>
    <a href="https://www.zappi.io" target="_blank" rel="noopener">zappi.io</a>
  </nav>
  <button type="button" class="topbar-icon" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
    <svg class="icon-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
      ><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z" fill="none" stroke="currentColor" stroke-width="1.4"
      ></path></svg
    >
    <svg class="icon-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
      ><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"></circle><path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3"
        stroke="currentColor"
        stroke-width="1.4"></path></svg
    >
  </button>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--topbar-height);
    padding: 0 16px 0 20px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    width: calc(var(--sidebar-width) - 36px);
    color: var(--fg);
  }

  .brand img {
    border-radius: 6px;
  }

  .brand-name {
    font-weight: 700;
  }

  .brand-product {
    color: var(--accent-fg);
    font-weight: 600;
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(320px, 100%);
    height: 34px;
    padding: 0 8px 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    color: var(--fg-faint);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .search-trigger:hover {
    border-color: var(--fg-faint);
  }

  .search-trigger kbd {
    margin-left: auto;
    padding: 0 6px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    font: 11px var(--font-sans);
  }

  .topbar-links {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
  }

  .topbar-links a {
    color: var(--fg-muted);
  }

  .topbar-links a:hover {
    color: var(--fg);
  }

  .topbar-icon {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .topbar-icon:hover {
    background: var(--hover);
    color: var(--fg);
  }

  .menu-button {
    display: none;
  }

  .icon-sun,
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }

  @media (max-width: 900px) {
    .menu-button {
      display: inline-grid;
    }

    .brand {
      width: auto;
    }

    .topbar-links {
      display: none;
    }

    .search-trigger {
      margin-left: auto;
      width: 34px;
      padding: 0;
      justify-content: center;
    }

    .search-trigger span,
    .search-trigger kbd {
      display: none;
    }
  }
</style>
