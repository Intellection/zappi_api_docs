---
import MethodBadge from "./MethodBadge.astro";
import type { NavGroup, NavItem } from "../lib/nav";

interface Props {
  general: NavItem[];
  reference: NavGroup[];
}

const { general, reference } = Astro.props;
---

<nav class="sidebar" id="sidebar" aria-label="Documentation" data-pagefind-ignore>
  <div class="sidebar-scroll">
    <ul class="nav-list">
      {
        general.map((item) => (
          <li>
            <a class="nav-link" href={`#${item.id}`} data-nav={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="nav-heading">API reference</p>
    {
      reference.map((group) => (
        <details class="nav-group" data-nav-group={group.id}>
          <summary class="nav-group-label">
            <a href={`#${group.id}`} data-nav={group.id}>
              {group.label}
            </a>
            <svg class="chevron" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
              <path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </summary>
          <ul class="nav-list nav-sublist">
            {group.items.map((item) => (
              <li>
                <a class="nav-link" href={`#${item.id}`} data-nav={item.id}>
                  <span>{item.label}</span>
                  {item.method && <MethodBadge method={item.method} size="sm" />}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
  <div class="sidebar-footer">
    Need API credentials? Contact <a href="mailto:support@zappistore.com">support@zappistore.com</a>
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    inset: var(--topbar-height) auto 0 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-width);
    background: var(--bg);
    border-right: 1px solid var(--border);
  }

  .sidebar-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 16px 12px 24px;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link,
  .nav-group-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 10px;
    border-radius: 6px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .nav-link:hover,
  .nav-group-label:hover {
    background: var(--hover);
    color: var(--fg);
  }

  .nav-link[aria-current="true"] {
    background: var(--accent-bg);
    color: var(--accent-fg);
    font-weight: 600;
  }

  .nav-heading {
    margin: 24px 10px 6px;
    color: var(--fg-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-group-label {
    color: var(--fg);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .nav-group-label::-webkit-details-marker {
    display: none;
  }

  .nav-group-label a {
    flex: 1;
    color: inherit;
  }

  .nav-group-label a[aria-current="true"] {
    color: var(--accent-fg);
  }

  .chevron {
    color: var(--fg-faint);
    transform: rotate(-90deg);
    transition: transform 0.15s;
  }

  .nav-group[open] .chevron {
    transform: none;
  }

  .nav-sublist {
    margin: 2px 0 8px 10px;
    padding-left: 8px;
    border-left: 1px solid var(--border);
  }

  .nav-sublist .nav-link {
    font-size: 13.5px;
  }

  .sidebar-footer {
    margin: 12px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    color: var(--fg-muted);
    font-size: 12.5px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.2s;
      box-shadow: 0 0 24px rgba(0, 0, 0, 0.18);
    }

    :global(html[data-nav-open]) .sidebar {
      transform: none;
    }
  }
</style>
